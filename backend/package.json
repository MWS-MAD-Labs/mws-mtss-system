{
  "name": "mws-mtss-system-backend",
  "version": "1.0.0",
  "description": "Backend API for MWS MTSS (Multi-Tiered System of Support)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:smoke": "jest tests/smoke --runInBand",
    "test:watch": "jest --watch",
    "test:cypress": "cypress run --e2e",
    "seed:mtss": "node src/scripts/seedMtssData.js",
    "reset:mtss:tier1:dry-run": "node src/scripts/resetInterventionsToTier1.js",
    "reset:mtss:tier1:apply": "node src/scripts/resetInterventionsToTier1.js --apply",
    "migrate:people": "node src/scripts/migrateToPerson.js",
    "migrate:people:apply": "node src/scripts/migrateToPerson.js --apply",
    "migrate:people:refs": "node src/scripts/remapPeopleRefs.js",
    "predev": "node src/scripts/syncPermissions.js --soft --retries 1 --wait 3",
    "permissions:sync": "node src/scripts/syncPermissions.js",
    "permissions:check": "node src/scripts/syncPermissions.js --check"
  },
  "keywords": [
    "mtss",
    "education",
    "student-support",
    "ai-psychology",
    "express",
    "mongodb"
  ],
  "author": "MWS Mad Labs",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.25.0",
    "@google/generative-ai": "^0.24.1",
    "@slack/socket-mode": "^2.0.2",
    "@slack/web-api": "^7.8.0",
    "axios": "^1.13.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "mws-central-auth": "github:MWS-MAD-Labs/mws-central-auth#v0.8.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.10",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cypress": "^15.7.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
